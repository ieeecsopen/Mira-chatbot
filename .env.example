# Gemini API Key (Required)
# Get your API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection (Required for persistent chat storage)
# Get your connection string from: https://cloud.mongodb.com/
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=yourapp
MONGODB_DB=mira

# Authentication Configuration (Required)
# Generate a strong random string for JWT_SECRET (at least 32 characters)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google OAuth Configuration (Optional)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create a new OAuth 2.0 Client ID
# 3. Add authorized JavaScript origins: 
#    - http://localhost:5173
#    - https://mira-chatbot-eta.vercel.app
# 4. Add authorized redirect URIs:
#    - http://localhost:5173
#    - http://localhost:5173/api/auth
#    - https://mira-chatbot-eta.vercel.app
#    - https://mira-chatbot-eta.vercel.app/api/auth
# 5. Copy the Client ID below
VITE_GOOGLE_CLIENT_ID=377645543898-6f9ulgss9fpvtlims9u996s85sltgee7.apps.googleusercontent.com
GOOGLE_CLIENT_ID=377645543898-6f9ulgss9fpvtlims9u996s85sltgee7.apps.googleusercontent.com

# GitHub OAuth Configuration (Optional)
# 1. Go to https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Set Homepage URL: http://localhost:5173 (for local) or https://mira-chatbot-eta.vercel.app (for production)
# 4. Set Authorization callback URL: http://localhost:5173/api/auth?action=github-callback (for local)
#    or https://mira-chatbot-eta.vercel.app/api/auth?action=github-callback (for production)
# 5. Copy the Client ID and generate a Client Secret
GITHUB_CLIENT_ID=Ov23liQbkNu3G0zPBa9n
GITHUB_CLIENT_SECRET=your-github-client-secret-here

# Note: Web search is now powered by Gemini's built-in Google Search grounding.
# No additional API keys needed for web search functionality!
